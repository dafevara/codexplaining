# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit the real file.

# ── LLM providers ────────────────────────────────────────────────────────────
# At least one is required depending on which --provider you use.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Model overrides (optional) ───────────────────────────────────────────────
# Defaults: claude-opus-4-7 (Anthropic) and gpt-4o (OpenAI).
# Uncomment and set to use a different model.

# HEG_ANTHROPIC_MODEL=claude-opus-4-7
# HEG_OPENAI_MODEL=gpt-4o
